# ------------------------------------------------------------------
# Everything here is optional.
# Nothing requires a paid service.
# ------------------------------------------------------------------

# Deployment mode: development (default for `npm run dev`), local (a production build on
# one machine: tests, labs, demos; PGlite allowed) or production (default for `npm start`:
# PostgreSQL + https APP_URL required, sample accounts refused). See docs/DEPLOYMENT.md.
# EDUWAVE_ENV=local

# Number of reverse proxies in front of the app that YOU run (e.g. 1 behind Nginx/Caddy).
# Used to read the real client IP for rate limits and the audit log. Leave 0 without a proxy.
TRUSTED_PROXY_HOPS=0

# Database. Leave empty to use the built-in PGlite database in ./.pglite (no install needed).
# For deployment, use any Postgres, e.g. Neon or Supabase free tier:
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# Time zone used to display dates.
APP_TIME_ZONE=Asia/Kolkata

# Public URL of the app (used in email links).
APP_URL=http://localhost:3000

# --- AI tutor + AI quiz drafting (optional, free, runs locally) ---
# Install Ollama (https://ollama.com), run `ollama pull llama3.2`, then:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Email notifications (optional) ---
# Any SMTP account works. For Gmail: enable 2-step verification, create an
# "App password", and use it here (never your real Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=eduWave <you@gmail.com>

# --- Live classes (optional) ---
# Defaults to the free public meet.jit.si. A school can self-host Jitsi and set:
# JITSI_DOMAIN=meet.yourschool.edu
