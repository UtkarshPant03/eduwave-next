# Leave DATABASE_URL empty to use the built-in PGlite database in ./.pglite (no install needed).
# For a hosted Postgres (Neon, Supabase, ...):  DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# Teachers must enter this code to register. Leave empty to disable teacher sign-up.
TEACHER_INVITE_CODE=change-me

# Time zone used to display dates.
APP_TIME_ZONE=Asia/Kolkata
