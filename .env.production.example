# ------------------------------------------------------------------
# Production configuration TEMPLATE. Placeholders only: never commit real values.
# Copy to the server (e.g. /etc/eduwave/eduwave.env, readable by the app user only).
# The app refuses to start if a required value is missing (src/lib/env.ts).
# ------------------------------------------------------------------
EDUWAVE_ENV=production
NODE_ENV=production

# REQUIRED. PostgreSQL 15 or newer. Use a dedicated database and role.
DATABASE_URL=postgres://eduwave_app:CHANGE_ME@db.internal.example:5432/eduwave?sslmode=require

# REQUIRED. The public https address students use.
APP_URL=https://lms.example.edu

# Reverse proxies you operate in front of the app (Nginx/Caddy = 1).
TRUSTED_PROXY_HOPS=1

APP_TIME_ZONE=Asia/Kolkata

# Optional email (all three of HOST/USER/PASS, or none).
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=465
# SMTP_USER=lms-notifications@example.edu
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=eduWave <lms-notifications@example.edu>

# Optional self-hosted services.
# JITSI_DOMAIN=meet.example.edu
# OLLAMA_URL=http://ollama.internal.example:11434
# OLLAMA_MODEL=llama3.2
